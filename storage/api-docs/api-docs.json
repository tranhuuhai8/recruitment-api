        "/api/auth/applicant/register": {
            "post": {
                "tags": [
                    "Applicant Authentication"
                ],
                "summary": "Đăng ký applicant",
                "description": "register",
                "operationId": "87fb56d760754a66a99da69a0f7729cc",
                "requestBody": {
                    "required": true,
                    "content": {
                        "application/json": {
                            "schema": {
                                "required": [
                                    "mail_address",
                                    "password",
                                    "password_confirmation"
                                ],
                                "properties": {
                                    "mail_address": {
                                        "type": "string",
                                        "format": "email",
                                        "example": "applicant@gmail.com"
                                    },
                                    "password": {
                                        "type": "string",
                                        "format": "password",
                                        "example": "123456Hh@"
                                    },
                                    "password_confirmation": {
                                        "type": "string",
                                        "format": "password",
                                        "example": "123456Hh@"
                                    }
                                },
                                "type": "object"
                            }
                        }
                    }
                },
                "responses": {
                    "200": {
                        "description": "Thành công"
                    },
                    "422": {
                        "description": "Lỗi validation"
                    }
                }
            }
        },
        "/api/auth/login": {
            "post": {
                "tags": [
                    "Auth"
                ],
                "summary": "Đăng nhập (dùng chung cho tất cả role)",
                "operationId": "unifiedLogin",
                "requestBody": {
                    "required": true,
                    "content": {
                        "application/json": {
                            "schema": {
                                "required": [
                                    "mail_address",
                                    "password"
                                ],
                                "properties": {
                                    "mail_address": {
                                        "type": "string",
                                        "format": "email",
                                        "example": "admin@gmail.com"
                                    },
                                    "password": {
                                        "type": "string",
                                        "minLength": 6,
                                        "example": "password123"
                                    }
                                },
                                "type": "object"
                            }
                        }
                    }
                },
                "responses": {
                    "200": {
                        "description": "Đăng nhập thành công",
                        "content": {
                            "application/json": {
                                "schema": {
                                    "properties": {
                                        "message": {
                                            "type": "string",
                                            "example": "Đăng nhập thành công."
                                        },
                                        "data": {
                                            "properties": {
                                                "token": {
                                                    "type": "string"
                                                },
                                                "token_type": {
                                                    "type": "string",
                                                    "example": "bearer"
                                                },
                                                "expires_in": {
                                                    "type": "integer",
                                                    "example": 3600
                                                },
                                                "role": {
                                                    "type": "string",
                                                    "enum": [
                                                        "admin",
                                                        "company",
                                                        "applicant"
                                                    ]
                                                },
                                                "user": {
                                                    "type": "object"
                                                }
                                            },
                                            "type": "object"
                                        }
                                    },
                                    "type": "object"
                                }
                            }
                        }
                    },
                    "401": {
                        "description": "Sai email hoặc mật khẩu"
                    },
                    "422": {
                        "description": "Validation thất bại"
                    }
                }
            }
        },
        "/api/auth/refresh": {
            "post": {
                "tags": [
