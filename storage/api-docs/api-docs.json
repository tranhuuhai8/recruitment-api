                    }
                ]
            }
        },
        "/api/auth/forgot-password": {
            "post": {
                "tags": [
                    "Authentication"
                ],
                "summary": "Quên mật khẩu",
                "description": "API gửi email reset mật khẩu",
                "operationId": "1c662981cefd33a817b78ed144f44559",
                "requestBody": {
                    "required": true,
                    "content": {
                        "application/json": {
                            "schema": {
                                "required": [
                                    "mail_address"
                                ],
                                "properties": {
                                    "mail_address": {
                                        "description": "Email đăng ký",
                                        "type": "string",
                                        "format": "email",
                                        "example": "user@gmail.com"
                                    }
                                },
                                "type": "object"
                            }
                        }
                    }
                },
                "responses": {
                    "200": {
                        "description": "Gửi email thành công",
                        "content": {
                            "application/json": {
                                "schema": {
                                    "properties": {
                                        "status_code": {
                                            "type": "integer",
                                            "example": 200
                                        },
                                        "message": {
                                            "type": "string",
                                            "example": ""
                                        },
                                        "data": {
                                            "type": "boolean",
                                            "example": true
                                        }
                                    },
                                    "type": "object"
                                }
                            }
                        }
                    },
                    "404": {
                        "description": "Email không tồn tại"
                    }
                }
            }
        },
        "/api/auth/reset-password/{token}": {
            "post": {
                "tags": [
                    "Authentication"
                ],
                "summary": "Đặt lại mật khẩu",
                "description": "API đặt lại mật khẩu bằng token từ email",
                "operationId": "1e3454614ce388eef7157dab62378363",
                "parameters": [
                    {
                        "name": "token",
                        "in": "path",
                        "description": "Token reset password từ email",
                        "required": true,
                        "schema": {
                            "type": "string",
                            "example": "abc123xyz"
                        }
                    }
                ],
                "requestBody": {
                    "required": true,
                    "content": {
                        "application/json": {
                            "schema": {
                                "required": [
                                    "mail_address",
                                    "password",
                                    "password_confirmation"
                                ],
                                "properties": {
                                    "mail_address": {
                                        "description": "Email đăng ký",
                                        "type": "string",
                                        "format": "email",
                                        "example": "user@gmail.com"
                                    },
                                    "password": {
                                        "description": "Mật khẩu mới",
                                        "type": "string",
                                        "format": "password",
                                        "example": "NewPass123@"
                                    },
                                    "password_confirmation": {
                                        "description": "Xác nhận mật khẩu mới",
                                        "type": "string",
                                        "format": "password",
                                        "example": "NewPass123@"
                                    }
                                },
                                "type": "object"
                            }
                        }
                    }
                },
                "responses": {
                    "200": {
                        "description": "Đặt lại mật khẩu thành công",
                        "content": {
                            "application/json": {
                                "schema": {
                                    "properties": {
                                        "status_code": {
                                            "type": "integer",
                                            "example": 200
                                        },
                                        "message": {
                                            "type": "string",
                                            "example": ""
                                        },
                                        "data": {
                                            "type": "boolean",
                                            "example": true
                                        }
                                    },
                                    "type": "object"
                                }
                            }
                        }
                    },
                    "404": {
                        "description": "Token không hợp lệ hoặc đã hết hạn"
                    }
                }
            }
        },
